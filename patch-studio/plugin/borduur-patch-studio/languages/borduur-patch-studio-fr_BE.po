msgid "Bestand"
msgstr "Fichier"

#: includes/admin/class-order-production.php:994
msgid "Dit bestandstype werd niet automatisch geanalyseerd (bv. PDF, AI, EPS of PSD): kleuren, lijnen en tekst zelf nakijken."
msgstr "Ce type de fichier n’a pas été analysé automatiquement (p. ex. PDF, AI, EPS ou PSD) : vérifiez vous-même les couleurs, lignes et textes."

#: includes/admin/class-order-production.php:1002
msgid "Keuze klant"
msgstr "Choix du client"

#. translators: 1: chosen technique, 2: recommended technique
#: includes/admin/class-order-production.php:1005
