# Local test environment for Patch Studio (NOT a real secret; only used on 127.0.0.1).
# Copy to tests/e2e/.env to override. start-wp.sh and the e2e scenarios read these values.
BPS_WP_DIR=/tmp/claude-0/-home-user-Path-finding-algorithm/119da7ba-62fd-5edf-a213-c52888883035/scratchpad/wp
BPS_WP_HOST=127.0.0.1
BPS_WP_PORT=8899
BPS_WP_ADMIN_USER=admin
BPS_WP_ADMIN_PASS=patchstudio-local-2026
BPS_WP_ADMIN_EMAIL=admin@example.test
# classic = [woocommerce_cart]/[woocommerce_checkout] shortcodes, block = WooCommerce blocks
BPS_WP_CHECKOUT=classic
# hello-elementor (theme of the live site) or any installed theme slug
BPS_WP_THEME=hello-elementor
# 1 = High-Performance Order Storage on, 0 = legacy post storage
BPS_WP_HPOS=1
