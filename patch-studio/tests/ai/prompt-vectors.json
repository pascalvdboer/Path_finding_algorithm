{
  "_doc": "Testvectoren voor includes/ai/class-ai-prompt-engine.php (tests/ai/run-prompt-php.php). T01–T20 staan uitgelegd in docs/ai/02-prompting.md §8.2; T21–T30 zijn 10 extra Franse klantvragen (SPEC-AI-DIENSTEN §7) die via Prompt_Adapter::input() lopen (adapter: true) en ook de samenvatting «Zo begrepen we je» controleren (understoodSummary). Samen de testset van 30 klantvragen. 'expect' vergelijkt alleen de genoemde velden; 'subjectContains' / 'promptContains' zijn deelstrings.",
  "translations": [
    { "id": "T01", "input": { "lang": "nl", "description": "een wolf met een bijl voor onze motorclub, rond, zwart-rood" },
      "expect": { "style": "club", "shape": "circle", "colors": ["black", "red"], "textMode": "none", "subjectContains": ["wolf", "axe", "motorcycle club"] } },
    { "id": "T02", "input": { "lang": "fr", "description": "un loup avec une hache pour notre club de moto, rond, noir et rouge" },
      "expect": { "style": "club", "shape": "circle", "colors": ["black", "red"], "subjectContains": ["wolf", "axe", "motorcycle club"] } },
    { "id": "T03", "input": { "lang": "nl", "description": "Een brullende leeuw met een kroon, goud en marineblauw, schild, tekst \"KFC Zandhoven\"" },
      "expect": { "style": "badge", "shape": "shield", "colors": ["gold-yellow", "navy blue"], "text": "KFC Zandhoven", "textMode": "studio", "subjectContains": ["roaring lion", "crown"], "promptNotContains": ["Zandhoven"] } },
    { "id": "T04", "input": { "lang": "fr", "description": "un aigle aux ailes déployées, style vintage, ovale, bleu marine et moutarde" },
      "expect": { "style": "vintage", "shape": "oval", "colors": ["navy blue", "mustard yellow"], "subjectContains": ["eagle", "spread wings"] } },
    { "id": "T05", "input": { "lang": "nl", "description": "scouts: een vos rond een kampvuur onder de sterren, groen en oranje" },
      "expect": { "style": "badge", "shape": "circle", "colors": ["green", "orange"], "subjectContains": ["fox", "around", "campfire", "stars"] } },
    { "id": "T06", "input": { "lang": "fr", "description": "mascotte d'un sanglier costaud avec un ballon de rugby" },
      "expect": { "style": "mascot", "shape": "contour", "subjectContains": ["tough wild boar", "ball"] } },
    { "id": "T07", "input": { "lang": "nl", "description": "alleen tekst \"JUNIOR CREW 2026\"" },
      "expect": { "style": "typographic", "textMode": "ai", "text": "JUNIOR CREW 2026", "promptContains": ["J-U-N-I-O-R / C-R-E-W / 2-0-2-6"] } },
    { "id": "T08", "input": { "lang": "fr", "description": "juste du texte « Équipe Rêve »" },
      "expect": { "style": "typographic", "textMode": "ai", "text": "Équipe Rêve", "promptContains": ["including every accent exactly as written", "É-q-u-i-p-e / R-ê-v-e"] } },
    { "id": "T09", "input": { "lang": "nl", "description": "militaire patch met een schedel en gekruiste bijlen, kaki en zwart" },
      "expect": { "style": "military", "shape": "shield", "colors": ["khaki", "black"], "subjectContains": ["skull", "crossed axe"] } },
    { "id": "T10", "input": { "lang": "nl", "description": "minimalistisch: een berg met een zon, wit", "background": "fabric", "fabric": "black" },
      "expect": { "style": "minimal", "colors": ["white"], "maxColors": 2, "subjectContains": ["mountain", "sun"], "promptContains": ["flat, uniform background color: black"] } },
    { "id": "T11", "input": { "lang": "fr", "description": "un chat mignon qui dort sur une lune, rose et lilas, découpé" },
      "expect": { "shape": "contour", "colors": ["pink", "lilac"], "subjectContains": ["cute", "cat", "sleeping", "moon"] } },
    { "id": "T12", "input": { "lang": "nl", "description": "een puma die springt, zwart en geel" },
      "expect": { "colors": ["black", "yellow"], "softBrand": true, "promptContains": ["refers to the generic thing, not to a brand"] } },
    { "id": "T13", "input": { "lang": "nl", "description": "voor onze brouwerij: hopbel en bierglas, vintage, mail me op jan@example.be of 0470 12 34 56" },
      "expect": { "style": "vintage", "warnings": ["personal_data_removed"], "subjectContains": ["hop cone", "beer glass"], "promptNotContains": ["example.be", "0470"] } },
    { "id": "T14", "input": { "lang": "fr", "description": "un dragon pour Jean Dupont, rouge et or" },
      "expect": { "colors": ["red", "gold-yellow"], "warnings": ["personal_data_removed"], "subjectContains": ["dragon"], "promptNotContains": ["Dupont"] } },
    { "id": "T15", "input": { "lang": "nl", "description": "brandweer: een helm met vlammen en een bijl, rood en wit, schild" },
      "expect": { "style": "badge", "shape": "shield", "colors": ["red", "white"], "subjectContains": ["helmet", "flames", "axe"] } },
    { "id": "T16", "input": { "lang": "nl", "description": "een uil met een bril op een stapel boeken voor onze school, blauw en geel" },
      "expect": { "colors": ["blue", "yellow"], "subjectContains": ["owl", "glasses", "books", "school"] } },
    { "id": "T17", "input": { "lang": "fr", "description": "une ancre et une vague, style marin, bleu et blanc, rond" },
      "expect": { "shape": "circle", "colors": ["blue", "white"], "subjectContains": ["anchor", "wave"] } },
    { "id": "T18", "input": { "lang": "nl", "description": "een everzwijn voor de jachtclub, bruin en groen, ovaal", "technique": "chenille" },
      "expect": { "shape": "oval", "colors": ["brown", "green"], "maxColors": 3, "subjectContains": ["wild boar", "hunting club"], "promptContains": ["chenille"] } },
    { "id": "T19", "input": { "lang": "fr", "description": "une abeille souriante pour notre miel, jaune et noir", "technique": "leather" },
      "expect": { "maxColors": 1, "subjectContains": ["smiling bee", "honey jar"], "promptContains": ["one single dark color"] } },
    { "id": "T20", "input": { "lang": "nl", "description": "fietsclub: een fiets met vleugels, retro", "text": "De Trappers", "textMode": "studio" },
      "expect": { "style": "vintage", "textMode": "studio", "subjectContains": ["bicycle", "wings", "cycling club"], "promptContains": ["for text that will be added later"], "promptNotContains": ["Trappers"] } },
    { "id": "T21", "adapter": true, "input": { "lang": "fr", "description": "un renard qui dort sous la lune, style minimaliste, bleu nuit et orange" },
      "expect": {"style": "minimal", "shape": "circle", "colors": ["navy blue", "orange"], "textMode": "none", "subjectContains": ["sleeping fox", "moon"], "understoodSummary": "renard qui dort sous la lune · rond · bleu marine et orange · style minimaliste"} },
    { "id": "T22", "adapter": true, "input": { "lang": "fr", "description": "écusson rond pour notre club de tennis avec deux raquettes croisées, vert et blanc" },
      "expect": {"style": "badge", "shape": "circle", "colors": ["green", "white"], "subjectContains": ["two crossed tennis rackets", "tennis club"], "promptNotContains": ["SUBJECT: with"], "understoodSummary": "club de tennis avec deux raquettes croisées · rond · vert et blanc · style badge / emblème"} },
    { "id": "T23", "adapter": true, "input": { "lang": "fr", "description": "une abeille souriante pour l'association des apiculteurs, jaune et noir, texte : Les Butineurs" },
      "expect": {"style": "badge", "colors": ["yellow", "black"], "text": "Les Butineurs", "textMode": "studio", "subjectContains": ["smiling bee", "for a beekeepers association"], "promptNotContains": ["Butineurs", "a association"]} },
    { "id": "T24", "adapter": true, "input": { "lang": "fr", "description": "un dragon qui crache du feu, mascotte, rouge et or" },
      "expect": {"style": "mascot", "shape": "contour", "colors": ["red", "gold-yellow"], "subjectContains": ["fire-breathing dragon"]} },
    { "id": "T25", "adapter": true, "input": { "lang": "fr", "description": "un phare avec des vagues, bleu marine et blanc, ovale" },
      "expect": {"style": "badge", "shape": "oval", "colors": ["navy blue", "white"], "subjectContains": ["lighthouse with waves"], "understoodSummary": "phare avec des vagues · ovale · bleu marine et blanc · style badge / emblème"} },
    { "id": "T26", "adapter": true, "input": { "lang": "fr", "description": "écusson militaire avec un hibou et des flèches, kaki" },
      "expect": {"style": "military", "shape": "shield", "colors": ["khaki"], "subjectContains": ["owl", "arrows"]} },
    { "id": "T27", "adapter": true, "input": { "lang": "fr", "description": "un chevalier avec une épée et un bouclier, blason, argent et bleu roi" },
      "expect": {"shape": "shield", "colors": ["silver grey", "royal blue"], "subjectContains": ["knight with a sword and a shield"]} },
    { "id": "T28", "adapter": true, "input": { "lang": "fr", "description": "logo pour une brasserie artisanale : une chope de bière et du houblon, style vintage, marron et crème" },
      "expect": {"style": "vintage", "shape": "oval", "colors": ["brown", "cream"], "subjectContains": ["beer mug", "hop cone", "craft brewery"]} },
    { "id": "T29", "adapter": true, "input": { "lang": "fr", "description": "un vélo de course avec des montagnes, pour notre club cycliste", "text": "Les Grimpeurs" },
      "expect": {"style": "badge", "textMode": "studio", "subjectContains": ["racing bicycle", "mountains", "cycling club"], "promptNotContains": ["Grimpeurs"]} },
    { "id": "T30", "adapter": true, "input": { "lang": "fr", "description": "une fleur de lys stylisée, une seule couleur, doré" },
      "expect": {"maxColors": 1, "colors": ["gold-yellow"], "subjectContains": ["stylized fleur-de-lis"], "promptContains": ["one single dark color"], "understoodSummary": "fleur de lys stylisée · rond · jaune doré · style badge / emblème"} }
  ],
  "safety": [
    { "id": "S01", "input": { "lang": "nl", "description": "het logo van Nike met onze clubnaam" }, "expect": { "code": "brand" } },
    { "id": "S02", "input": { "lang": "fr", "description": "le logo du Standard de Liège en écusson" }, "expect": { "code": "brand" } },
    { "id": "S03", "input": { "lang": "nl", "description": "een portret van mijn vader als superheld" }, "expect": { "code": "person" } },
    { "id": "S04", "input": { "lang": "nl", "description": "politie embleem voor op een jas" }, "expect": { "code": "official" } },
    { "id": "S05", "input": { "lang": "nl", "description": "een adelaar met een hakenkruis" }, "expect": { "code": "hate" } },
    { "id": "S06", "input": { "lang": "fr", "description": "un renard dans le style de Hergé" }, "expect": { "code": "artist" } },
    { "id": "S07", "input": { "lang": "nl", "description": "maak een kopie van ons oude clublogo" }, "expect": { "code": "copy" } },
    { "id": "S08", "input": { "lang": "nl", "description": "een wolf", "text": "Hells Angels" }, "expect": { "code": "brand" } },
    { "id": "S09", "input": { "lang": "nl", "description": "een puma, het logo van het merk" }, "expect": { "code": "brand" } },
    { "id": "S10", "input": { "lang": "nl", "description": "  " }, "expect": { "code": "empty" } },
    { "id": "S11", "input": { "lang": "nl", "description": "een tattoo-stijl zwaluw in de stijl van de jaren 50" }, "expect": { "ok": true } },
    { "id": "S12", "input": { "lang": "nl", "description": "een portret van mijn hond" }, "expect": { "ok": true } },
    { "id": "S13", "input": { "lang": "fr", "description": "un portrait de Stromae" }, "expect": { "code": "person" } },
    { "id": "S14", "input": { "lang": "fr", "description": "une feuille de cannabis rasta" }, "expect": { "code": "drugs" } },
    { "id": "S15", "input": { "lang": "fr", "description": "insigne de la police belge avec une étoile" }, "expect": { "code": "official" } },
    { "id": "S16", "input": { "lang": "fr", "description": "un portrait de mon chien avec une couronne" }, "expect": { "ok": true } }
  ],
  "refine": [
    { "id": "R01", "base": "T01", "instruction": "maak de wolf bozer", "expect": { "route": "ai_edit", "promptContains": ["CHANGE ONLY THIS: make the wolf angrier", "the color palette"] } },
    { "id": "R02", "base": "T02", "instruction": "fais le loup plus méchant", "expect": { "route": "ai_edit", "promptContains": ["make the wolf fiercer"] } },
    { "id": "R03", "base": "T01", "instruction": "maak het blauw", "expect": { "route": "local", "action": "open_colors" } },
    { "id": "R04", "base": "T01", "instruction": "minder kleuren graag", "expect": { "route": "local", "action": "reduce_colors" } },
    { "id": "R05", "base": "T01", "instruction": "zet er \"WOLF MC\" bij", "expect": { "route": "local", "action": "open_text", "text": "WOLF MC" } },
    { "id": "R06", "base": "T01", "instruction": "voeg vlammen toe", "expect": { "route": "ai_edit", "promptContains": ["add flames"] } },
    { "id": "R07", "base": "T01", "instruction": "haal de bijl weg", "expect": { "route": "ai_edit", "promptContains": ["remove the axe"] } },
    { "id": "R08", "base": "T01", "instruction": "groter", "expect": { "route": "local", "action": "open_size" } },
    { "id": "R09", "base": "T01", "instruction": "maak de vlammen groter", "expect": { "route": "ai_edit", "promptContains": ["make the flames larger"] } },
    { "id": "R10", "base": "T07", "instruction": "fais-le en forme ronde", "expect": { "route": "local", "action": "open_shape" } },
    { "id": "R11", "base": "T01", "instruction": "maak de wolf blauw", "forceAi": true, "expect": { "route": "ai_edit", "promptContains": ["make the wolf blue"], "promptNotContains": ["the color palette"] } },
    { "id": "R12", "base": "T01", "instruction": "maak er het Harley-Davidson logo van", "expect": { "route": "blocked", "code": "brand" } },
    { "id": "R13", "base": "T26", "instruction": "mets l'écusson en carré", "expect": {"route": "local", "action": "open_shape", "shape": "rect"} },
    { "id": "R14", "base": "T26", "instruction": "déplace-le un peu", "expect": {"route": "local", "action": "open_arrange"} },
    { "id": "R15", "base": "T26", "instruction": "rends le hibou plus méchant", "expect": {"route": "ai_edit", "promptContains": ["CHANGE ONLY THIS: make the owl fiercer", "French"]} },
    { "id": "R16", "base": "T27", "instruction": "en bleu roi et blanc", "expect": {"route": "local", "action": "open_colors", "colors": ["royal blue", "white"]} }
