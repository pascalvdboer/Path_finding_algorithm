# The address of the ONE running brain every agent shares.
# Copy this file to ".env" and set it to your brain's machine.

# Brain running on this same computer:
BRAIN_URL=http://127.0.0.1:8000

# Brain running on your NAS / a server (start it with --host 0.0.0.0):
# BRAIN_URL=http://192.168.1.50:8000
